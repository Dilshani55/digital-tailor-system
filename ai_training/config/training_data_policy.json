{
  "schema_version": "1.0.0",
  "random_seed": 42,
  "target_heads": [
    "garment_type",
    "neckline_type",
    "sleeve_length",
    "sleeve_style"
  ],
  "planning_thresholds": {
    "minimum_viable_baseline_samples": 20,
    "minimum_recommended_samples": 100,
    "imbalance_warning_ratio": 5.0
  },
  "partial_label_policy": "permitted_with_masked_loss",
  "manual_review_policy": "candidate_mappings_must_be_reviewed_before_training",
  "split_preservation_policy": "preserve_source_level_splits_never_move_records",
  "evidence_status_policy": {
    "accepted_statuses": [
      "direct"
    ],
    "candidate_statuses": [
      "candidate_mapping"
    ],
    "rejected_statuses": [
      "unsupported",
      "conflicting",
      "missing",
      "ambiguous"
    ]
  },
  "masked_loss_policy": {
    "missing_heads_use_mask": true,
    "loss_contribution_for_missing": 0.0,
    "never_map_missing_to_class_zero": true
  },
  "manual_review_priority_rules": {
    "train_split_priority": "high",
    "rare_label_evidence_boost": true,
    "single_missing_head_garment_type_boost": true,
    "many_missing_heads_penalty": true,
    "auto_approve_ambiguous": false
  },
  "disclaimer": "Thresholds (20 baseline, 100 recommended, 5.0 ratio) are project planning guidelines, not universal scientific guarantees."
}
