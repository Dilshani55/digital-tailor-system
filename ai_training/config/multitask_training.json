{
  "schema_version": "1.0.0",
  "random_seed": 42,
  "image_size": 224,
  "smoke_epochs": 1,
  "smoke_train_records": 256,
  "smoke_val_records": 128,
  "full_epochs": 20,
  "batch_size": 8,
  "num_workers": 0,
  "device": "auto",
  "pretrained_path": "ai_training/data/training_runs/pretrained/yolov8n-cls.pt",
  "pretrained_backbone_identifier": "yolov8n-cls",
  "learning_rate": 0.001,
  "weight_decay": 0.0005,
  "freeze_backbone": true,
  "class_weight_cap": 5.0,
  "provenance_weights": {
    "human_verified": 1.0,
    "fashionpedia_direct": 1.0,
    "fashionpedia_rule_derived": 0.8,
    "accepted_pseudo_label": 0.5
  },
  "early_stopping": {
    "enabled": true,
    "patience": 5,
    "min_delta": 0.001,
    "monitor": "val_loss"
  }
}
