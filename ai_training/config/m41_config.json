{
  "schema_version": "1.0.0",
  "random_seed": 42,
  "image_size": 224,
  "batch_size": 16,
  "num_workers": 3,
  "device": "auto",
  "pretrained_path": "ai_training/data/training_runs/pretrained/yolov8n-cls.pt",
  "pretrained_backbone_identifier": "yolov8n-cls",
  "stage_a_epochs": 3,
  "stage_a_head_lr": 0.001,
  "stage_b_epochs": 6,
  "stage_b_backbone_lr": 0.0001,
  "stage_b_head_lr": 0.0005,
  "early_stopping_patience": 3,
  "weight_decay": 0.0001,
  "class_weight_cap": 5.0,
  "provenance_weights": {
    "human_verified": 1.0,
    "fashionpedia_direct": 1.0,
    "fashionpedia_rule_derived": 0.8,
    "accepted_pseudo_label": 0.5,
    "df2_human_category": 1.0,
    "derived_from_explicit_sleeveless": 1.0,
    "masked_removed_class": 0.0,
    "dmm_human_shape": 1.0,
    "dmm_shop_category": 0.5,
    "dmm_navel_uncovered": 0.5,
    "candidate_dmm_lapel_needs_human_review": 0.0
  },
  "full_image_prob": 0.5,
  "augmentation": "basic",
  "_note": "M41 = M40 settings unchanged + DeepFashion-MultiModal records (manifests_m41). Only the data changes. dmm_shop_category / dmm_navel_uncovered are garment-type proxies (merchant category, navel rule), down-weighted to 0.5; lapel->collared candidates are masked in the manifests (weight 0 as a second guard)."
}