# Digital Tailor backend configuration. Copy to backend/.env and edit; never commit .env.

# Secrets: generate long random values, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/digital_tailor_db

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: enables "Continue with Google" (Google Cloud OAuth client ID). Leave empty to disable.
GOOGLE_CLIENT_ID=

# Optional: overrides for the plausible measurement ranges, e.g. {"bust_cm": [60, 170]}
# MEASUREMENT_RANGES_JSON=

# Accounts (comma-separated e-mails) allowed to open the researcher dashboard and CSV export.
# Study-wide data is hidden from everyone else. Participants are shown only as anonymous ids.
RESEARCHER_EMAILS=
